# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ADMIN_USER_ID=your-supabase-admin-user-uuid

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
ADMIN_USER_ID=your-supabase-admin-user-uuid

# Backblaze B2 Storage Configuration - Account 1: Writing & Journals (10 GB)
BACKBLAZE_BUCKET=your-b2-bucket-name
BACKBLAZE_ENDPOINT=s3.us-east-005.backblazeb2.com
BACKBLAZE_REGION=us-east-005
BACKBLAZE_KEY_ID=your-backblaze-key-id
BACKBLAZE_APPLICATION_KEY=your-backblaze-application-key

# Backblaze B2 Visuals & GIFs Pool - Account 2 (10 GB)
BACKBLAZE_MEDIA_BUCKET_1=your-media-bucket-1
BACKBLAZE_MEDIA_ENDPOINT_1=s3.us-east-005.backblazeb2.com
BACKBLAZE_MEDIA_REGION_1=us-east-005
BACKBLAZE_MEDIA_KEY_ID_1=your-media-key-id-1
BACKBLAZE_MEDIA_APPLICATION_KEY_1=your-media-app-key-1

# Backblaze B2 Visuals & GIFs Pool - Account 3 (10 GB)
BACKBLAZE_MEDIA_BUCKET_2=your-media-bucket-2
BACKBLAZE_MEDIA_ENDPOINT_2=s3.us-east-005.backblazeb2.com
BACKBLAZE_MEDIA_REGION_2=us-east-005
BACKBLAZE_MEDIA_KEY_ID_2=your-media-key-id-2
BACKBLAZE_MEDIA_APPLICATION_KEY_2=your-media-app-key-2

# Site URL for CORS allowlist (your production domain, e.g. https://yourblog.vercel.app)
ALLOWED_ORIGIN=https://your-blog-domain.com
VITE_SITE_URL=https://your-blog-domain.com

# GitHub Activity Integration (Optional: GITHUB_TOKEN includes private contributions)
# GITHUB_TOKEN must be a token belonging to the account whose private
# contributions should be counted; the graph total includes private counts.
# GITHUB_TOKEN=ghp_yourPersonalAccessToken
# GITHUB_USERNAME=q04ti
# Server-only: extra GitHub accounts whose contributions are merged into the
# graph. Never sent to or echoed in the browser; visitors only see q04ti.
# GITHUB_CONTRIBUTIONS_EXTRA_USERS=
